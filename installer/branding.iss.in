; The installer's names and identity, from branding.cmake (generated by CMake).
#define AppName "@PRODUCT_NAME@"
#define AppVersion "@PRODUCT_VERSION@"
#define Publisher "@PRODUCT_PUBLISHER@"
#define Website "@PRODUCT_WEBSITE@"
#define Copyright "@PRODUCT_COPYRIGHT@"
#define Description "@PRODUCT_DESCRIPTION@"
#define ExeName "@PRODUCT_EXECUTABLE@.exe"
#define SetupName "@PRODUCT_EXECUTABLE@"
#define Extension "@PRODUCT_FILE_EXTENSION@"
#define AppGuid "@PRODUCT_INSTALLER_ID@"
; The running app's mutex (SingleInstance::appName()): Setup asks for it to be closed.
#define AppMutex "@PRODUCT_ORGANIZATION@-@PRODUCT_EXECUTABLE@"
; The file type setlists open as (Windows' "ProgID").
#define ProgId "@PRODUCT_ORGANIZATION@.@PRODUCT_EXECUTABLE@.Setlist"
#define IconFile "@PRODUCT_ICON@"
; The note shown before installing (from installer/ALPHA.txt.in).
#define InfoBefore "@CMAKE_BINARY_DIR@/installer/ALPHA.txt"
