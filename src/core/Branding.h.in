#pragma once

// GENERATED from branding.cmake at configure time. Do not edit this file:
// change branding.cmake and rebuild.

#include <QString>
#include <QStringList>

namespace gigchain::branding {

inline QString brand() { return QStringLiteral("@PRODUCT_BRAND@"); }
inline QString edition() { return QStringLiteral("@PRODUCT_EDITION@"); }
inline QString name() { return QStringLiteral("@PRODUCT_NAME@"); }
inline QString version() { return QStringLiteral("@PRODUCT_VERSION@"); }
inline QString organization() { return QStringLiteral("@PRODUCT_ORGANIZATION@"); }
inline QString executable() { return QStringLiteral("@PRODUCT_EXECUTABLE@"); }
inline QString website() { return QStringLiteral("@PRODUCT_WEBSITE@"); }
// Setlist files end with this, e.g. ".gigchain.json".
inline QString setlistSuffix() { return QStringLiteral(".@PRODUCT_FILE_EXTENSION@.json"); }

// Earlier names: "organization/application" pairs whose settings are carried
// over, and the setlist extensions they used.
inline QStringList previousSettings()
{
    return QStringLiteral("@PRODUCT_PREVIOUS_SETTINGS@").split(u';', Qt::SkipEmptyParts);
}
inline QStringList previousFileExtensions()
{
    return QStringLiteral("@PRODUCT_PREVIOUS_FILE_EXTENSIONS@").split(u';', Qt::SkipEmptyParts);
}

} // namespace gigchain::branding
